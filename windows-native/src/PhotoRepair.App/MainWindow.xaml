<Window x:Class="PhotoRepair.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:presentation="using:PhotoRepair.Windows"
 xmlns:local="using:PhotoRepair.App"
 Title="Photo Metadata Repair Inspector">
 <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <MenuBar>
  <MenuBarItem Title="File">
   <MenuFlyoutItem Text="Select folder…" Click="PickFolder" x:Name="FolderMenu"/>
   <MenuFlyoutItem x:Name="ScanMenu" Text="Scan folder" Click="ScanFolder"/>
   <MenuFlyoutItem x:Name="StopMenu" Text="Stop scan" Click="StopScan"/>
   <MenuFlyoutSeparator/><MenuFlyoutItem Text="Exit" Click="ExitApp"/>
  </MenuBarItem>
  <MenuBarItem Title="View">
   <MenuFlyoutItem Text="Library" Tag="0" Click="ChooseView"/>
   <MenuFlyoutItem Text="Review" Tag="1" Click="ChooseView"/>
   <MenuFlyoutItem Text="Repair log" Tag="2" Click="ChooseView"/>
  </MenuBarItem>
  <MenuBarItem Title="Help">
   <MenuFlyoutItem Text="How to use" Click="ShowHelp"/>
   <MenuFlyoutItem Text="Privacy policy" Click="OpenPrivacy"/>
   <MenuFlyoutItem Text="Report an issue" Click="OpenIssues"/>
   <MenuFlyoutSeparator/><MenuFlyoutItem Text="About" Click="ShowAbout"/>
  </MenuBarItem>
 </MenuBar>
 <Grid x:Name="Root" Grid.Row="1" Padding="12" RowSpacing="10" SizeChanged="LayoutChanged" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Grid.Resources>
  <local:TableColumns x:Key="ColumnLayout"/>
  <Style x:Key="ColumnDivider" TargetType="local:ColumnResizeGrip">
   <Setter Property="Width" Value="8"/>
   <Setter Property="HorizontalAlignment" Value="Right"/>
  </Style>
  <Style x:Key="TableHeading" TargetType="Button">
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="VerticalAlignment" Value="Stretch"/>
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="0,4,10,4"/>
   <Setter Property="MinHeight" Value="28"/>
  </Style>
 </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Content="Select folder…" Click="PickFolder" IsEnabled="{Binding CanSelectFolder}" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="2" VerticalAlignment="Center">
    <TextBlock Text="{Binding SelectedFolderDisplay}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{Binding SelectedFolderDisplay}" AutomationProperties.Name="Selected folder"/>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button Content="Scan folder" Click="ScanFolder" IsEnabled="{Binding CanScan}" Style="{StaticResource AccentButtonStyle}"/>
    <Button x:Name="StopButton" Content="Stop scan" Click="StopScan" Visibility="Collapsed"/>
   </StackPanel>
  </Grid>
  <StackPanel x:Name="StatusPanel" Grid.Row="1" Spacing="4" Visibility="Collapsed">
   <InfoBar x:Name="Notification" IsOpen="True" IsClosable="False" Message="{Binding Status}"/>
   <Grid x:Name="ScanProgress" Visibility="Collapsed"><TextBlock Text="{Binding ProgressText}"/><ProgressBar IsIndeterminate="{Binding IsDiscovering}" Margin="0,24,0,0" Value="{Binding Completed}" Maximum="{Binding Total}"/></Grid>
  </StackPanel>
  <StackPanel x:Name="ResultsControls" Grid.Row="2" Spacing="4" Visibility="Collapsed">
   <StackPanel x:Name="NavigationBar" Orientation="Horizontal" Spacing="12">
    <ListBox x:Name="ViewPicker" SelectedIndex="0" SelectionChanged="ViewChanged" AutomationProperties.Name="View" BorderThickness="0" HorizontalAlignment="Left">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBoxItem Content="Library"/><ListBoxItem Content="Review"/><ListBoxItem Content="Repair log"/>
    </ListBox>
   </StackPanel>
   <StackPanel x:Name="FilterBar" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
    <TextBox x:Name="SearchBox" Width="220" PlaceholderText="Filter scanned files…" AutomationProperties.Name="Filter scanned results by filename or location" TextChanged="SearchChanged"/>
    <ComboBox x:Name="MediaFilter" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="File type">
     <ComboBoxItem Content="All files" Tag="All"/><ComboBoxItem Content="Photos" Tag="image"/><ComboBoxItem Content="Videos" Tag="video"/>
    </ComboBox>
    <ComboBox x:Name="ReviewFilter" HorizontalAlignment="Left" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Review filter">
     <ComboBoxItem Content="All review items"/><ComboBoxItem Content="Missing Taken At"/><ComboBoxItem Content="Taken &gt; Created"/><ComboBoxItem Content="Taken &gt; Modified"/>
    </ComboBox>
   </StackPanel>
  </StackPanel>
  <StackPanel x:Name="WelcomePanel" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="380">
   <TextBlock x:Name="EmptyTitle" Text="Inspect your photo dates" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
   <TextBlock x:Name="EmptyDescription" Text="Choose a folder above, then click Scan folder. You can review dates before making any changes." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
  <Grid x:Name="TableRegion" Grid.Row="3" Visibility="Collapsed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <ScrollViewer x:Name="HeaderScroll" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
    <Grid x:Name="TableHeader" HorizontalAlignment="Left" Width="{Binding TotalWidth, Source={StaticResource ColumnLayout}}">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding DisplayItems[0].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[1].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[2].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[3].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[4].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[5].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[6].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[7].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[8].Width, Source={StaticResource ColumnLayout}}"/>
      <ColumnDefinition Width="{Binding DisplayItems[9].Width, Source={StaticResource ColumnLayout}}"/>
     </Grid.ColumnDefinitions>
     <Button Grid.Column="1" Style="{StaticResource TableHeading}" Tag="File" Content="File" Click="SortColumn"/>
     <Button Grid.Column="2" Style="{StaticResource TableHeading}" Tag="Type" Content="Type" Click="SortColumn"/>
     <Button Grid.Column="3" Style="{StaticResource TableHeading}" Tag="Size" Content="Size" Click="SortColumn"/>
     <Button Grid.Column="4" Style="{StaticResource TableHeading}" Tag="Created" Content="Created" Click="SortColumn"/>
     <Button Grid.Column="5" Style="{StaticResource TableHeading}" Tag="Modified" Content="Modified" Click="SortColumn"/>
     <Button Grid.Column="6" Style="{StaticResource TableHeading}" Tag="Taken At" Content="Taken At" Click="SortColumn"/>
     <Button Grid.Column="7" Style="{StaticResource TableHeading}" Tag="Filename Date" Content="Filename Date" Click="SortColumn"/>
     <Button Grid.Column="8" Style="{StaticResource TableHeading}" Tag="Location" Content="Location" Click="SortColumn"/>
     <Button Grid.Column="9" Style="{StaticResource TableHeading}" Tag="Review reason" Content="Review reason" Click="SortColumn"/>
     <local:ColumnResizeGrip Grid.Column="1" Tag="1" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize File column" ToolTipService.ToolTip="Drag to resize; arrow keys adjust width"/>
     <local:ColumnResizeGrip Grid.Column="2" Tag="2" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Type column"/>
     <local:ColumnResizeGrip Grid.Column="3" Tag="3" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Size column"/>
     <local:ColumnResizeGrip Grid.Column="4" Tag="4" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Created column"/>
     <local:ColumnResizeGrip Grid.Column="5" Tag="5" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Modified column"/>
     <local:ColumnResizeGrip Grid.Column="6" Tag="6" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Taken At column"/>
     <local:ColumnResizeGrip Grid.Column="7" Tag="7" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Filename Date column"/>
     <local:ColumnResizeGrip Grid.Column="8" Tag="8" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Location column"/>
     <local:ColumnResizeGrip Grid.Column="9" Tag="9" Style="{StaticResource ColumnDivider}" DragDelta="ResizeColumn" KeyDown="ResizeColumnKey" AutomationProperties.Name="Resize Review reason column"/>
    </Grid>
   </ScrollViewer>
  <ListView x:Name="Table" Grid.Row="1" ItemsSource="{Binding Rows}" SelectionMode="None" Visibility="Collapsed" KeyDown="TableKeyDown"
   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
   <ListView.ItemContainerStyle>
    <Style TargetType="ListViewItem">
     <Setter Property="HorizontalContentAlignment" Value="Left"/>
     <Setter Property="Padding" Value="0"/>
     <Setter Property="MinHeight" Value="0"/>
     <Setter Property="UseSystemFocusVisuals" Value="True"/>
     <!-- The stock presenter reserves space for its own selection checkbox.
          This table supplies one checkbox bound to the shared selection model. -->
     <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
       HorizontalContentAlignment="Left"/>
     </ControlTemplate></Setter.Value></Setter>
    </Style>
   </ListView.ItemContainerStyle>

   <ListView.ItemTemplate>
    <DataTemplate x:DataType="presentation:MediaRow">
     <Grid Tag="MediaRow" HorizontalAlignment="Left" Width="{Binding TotalWidth, Source={StaticResource ColumnLayout}}" Loaded="TableRowLoaded" Tapped="RowTapped" KeyDown="RowKeyDown" Padding="0,2" Background="Transparent" ToolTipService.ToolTip="{Binding Record.Path}">
      <Grid.Resources><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/></Style></Grid.Resources>
      <Grid.ContextFlyout><MenuFlyout><MenuFlyoutItem Text="Open file" Click="OpenFile"/><MenuFlyoutItem Text="Show in Explorer" Click="RevealFile"/><MenuFlyoutItem Text="Copy full path" Click="CopyPath"/></MenuFlyout></Grid.ContextFlyout>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="{Binding DisplayItems[0].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[1].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[2].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[3].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[4].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[5].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[6].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[7].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[8].Width, Source={StaticResource ColumnLayout}}"/>
       <ColumnDefinition Width="{Binding DisplayItems[9].Width, Source={StaticResource ColumnLayout}}"/>
      </Grid.ColumnDefinitions>
      <!-- A click sets IsChecked locally. Compiled binding updates reapply the
           model value even after interaction; runtime OneWay Binding can detach. -->
      <CheckBox Tag="0" MinWidth="0" MinHeight="24" Height="28" Width="32" HorizontalAlignment="Left" IsChecked="{x:Bind IsSelected, Mode=OneWay}" Click="CheckboxClicked" AutomationProperties.Name="{Binding Record.Name}"/>
      <TextBlock Tag="1" Grid.Column="1" Text="{Binding Record.Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Record.Name}"/>
      <TextBlock Tag="2" Grid.Column="2" Text="{Binding Record.MediaType}"/>
      <TextBlock Tag="3" Grid.Column="3" Text="{Binding Record.Size}"/>
      <TextBlock Tag="4" Grid.Column="4" Text="{Binding Record.Created}"/>
      <TextBlock Tag="5" Grid.Column="5" Text="{Binding Record.Modified}"/>
      <TextBlock Tag="6" Grid.Column="6" Text="{Binding Record.Taken}"/>
      <TextBlock Tag="7" Grid.Column="7" Text="{Binding Record.FilenameDate}"/>
      <TextBlock Tag="8" Grid.Column="8" Text="{Binding Record.Location}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Record.Location}"/>
      <TextBlock Tag="9" Grid.Column="9" Text="{Binding Record.ReviewReason}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Record.ReviewReason}"/>
     </Grid>
    </DataTemplate>
   </ListView.ItemTemplate>
  </ListView>
  </Grid>
  <ScrollViewer x:Name="LogPanel" Grid.Row="3" Visibility="Collapsed"><TextBlock Text="{Binding Log}" IsTextSelectionEnabled="True" FontFamily="Consolas" TextWrapping="Wrap"/></ScrollViewer>
  <StackPanel x:Name="SelectionPanel" Grid.Row="4" Spacing="6" Visibility="Collapsed">
   <StackPanel x:Name="SelectionActions" Orientation="Horizontal" Spacing="12">
    <Button Content="Select all" Click="SelectAll"/>
    <Button Content="Clear selection" Click="ClearSelection"/>
   </StackPanel>
   <StackPanel x:Name="RepairBar" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
    <ComboBox x:Name="RepairMethodPicker" DisplayMemberPath="Label" SelectionChanged="RepairMethodChanged" AutomationProperties.Name="Repair method"/>
    <CheckBox x:Name="BackupOriginals" Content="Backup originals" IsChecked="True" Click="BackupToggled"/>
    <Button Content="Review changes…" Click="ReviewChanges" IsEnabled="{Binding CanReviewChanges}"/>
   </StackPanel>
  </StackPanel>
 </Grid>
 <Grid Grid.Row="2" Padding="12,6" ColumnSpacing="16" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBlock x:Name="FooterStatus" Text="Ready" TextTrimming="CharacterEllipsis"/>
  <TextBlock x:Name="FooterCounts" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
 </Grid>
 </Grid>
</Window>
